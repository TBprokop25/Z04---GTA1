<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\**\*.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Single-file publish nekdy vynecha velke soubory (>2 MB). Natvrdo zkopiruj vsechny assety do publish vystupu. -->
  <Target Name="ForceCopyAssetsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <AllAssets Include="assets\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AllAssets)"
          DestinationFiles="@(AllAssets->'$(PublishDir)assets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
  </Target>
</Project>
